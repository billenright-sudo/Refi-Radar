# Copy this to .env and fill in your values
# Never commit .env to git

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here
FRED_API_KEY=your-fred-api-key-here

# Auth — generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# Email (Gmail App Password — NOT your Google account password)
# Enable 2FA on Gmail, then create App Password at myaccount.google.com/apppasswords
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# The public URL of your app (used in invite emails)
APP_URL=https://your-app.run.app

# Optional
PORT=8080
DATA_DIR=/data
CLAUDE_MODEL=claude-sonnet-4-5
