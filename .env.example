# Copy this to .env and fill in your values
# Never commit .env to git

# Required: Anthropic API key for live mortgage rate fetching
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required: FRED (Federal Reserve) API key for 10-year Treasury data
# Free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# Optional: Port (Cloud Run sets this automatically)
PORT=8080

# Optional: Override the Claude model used for rate fetching
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: Override the SQLite database directory
# Defaults to ./server/data/ locally, /data/ in Docker
# DATA_DIR=/data
